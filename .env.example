# Copia este archivo a .env (está en .gitignore) y rellena los valores.
# Genera una clave segura con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Inventario (CONTEXT-9): PostgreSQL de Supabase ---
# Usuarios y autenticación siguen en TinyDB; SKUs y movimientos de stock van a Supabase.
# Cadena de conexión con la contraseña de la base de datos (no la URL del proyecto ni la
# clave publishable, que son para la API REST): Supabase > Connect > "Session pooler".
# Formato: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Si la contraseña lleva caracteres especiales (@ : / # ?), escríbelos codificados (%40, %3A...).
DATABASE_URL=

# --- Restablecimiento de contraseña (AUTH-03) ---
# API key de Resend (https://resend.com/api-keys). Si se deja vacía no se envía ningún correo.
RESEND_API_KEY=
# Solo desarrollo: sin API key, escribe el enlace de restablecimiento en el log del servidor
# para poder probar el flujo. No lo actives en producción: quien lea el log puede cambiar
# la contraseña de la cuenta.
PASSWORD_RESET_LOG_LINK=false
# Con onboarding@resend.dev (sin dominio propio) Resend solo entrega al email de tu cuenta.
EMAIL_FROM=TrackFlow <onboarding@resend.dev>
# URL del backoffice (Next.js), base del enlace /reset-password?token=...
FRONTEND_URL=http://localhost:3001
# Validez del enlace en minutos (15-60) y máximo de enlaces por usuario y hora.
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=5

# --- Gestor de incidencias: embeddings (búsqueda semántica, similares, duplicados, triaje) ---
# fastembed = modelo multilingüe local (se descarga la primera vez, ~220 MB, sin API key).
# hashing = sin descarga, solo parecido léxico (lo usan los tests; plan B automático si el modelo no carga).
EMBEDDINGS_PROVIDER=fastembed
# Opcionales: modelo de fastembed y carpeta donde se guarda (por defecto ~/.cache/fastembed).
# EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDINGS_CACHE_DIR=

# --- Docker Compose (docker compose up) ---
# Puertos publicados en el host.
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
API_PORT=8000
# Orígenes del navegador a los que la API permite llamar (el backoffice).
BACKOFFICE_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Contenedor -> contenedor: nombre del servicio Docker, nunca localhost.
API_INTERNAL_URL=http://backend:8000
# Navegador -> API y web pública: el navegador está fuera de la red Docker, usa el puerto publicado.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000/
# Recarga en caliente sobre bind mounts (Windows/macOS no propagan eventos de archivos).
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
NEXT_TELEMETRY_DISABLED=1
